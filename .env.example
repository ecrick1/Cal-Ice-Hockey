# ---- Public (safe to expose in the browser bundle) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---- Server only. NEVER import these from a client component. ----
# Used by prototype/api-manage-users.mjs and trusted setup scripts.
# Current direct REST helpers expect the legacy service_role JWT here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Recruit form notification (Phase 4) ----
RESEND_API_KEY=
RECRUIT_NOTIFY_TO=
RECRUIT_NOTIFY_FROM=

# ---- Public site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# ---- Direct Postgres connection, for running migrations ----
# Supabase dashboard -> Connect -> Session pooler. Replace [YOUR-PASSWORD]
# with the database password. Server-side only; never in a client bundle.
DATABASE_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
